<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="10dp">



            <!-- Title -->
            <TextView
                android:id="@+id/tv_ac_controls_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:text="AC Controls"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- AC Power and Swing Switches -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Switch
                    android:id="@+id/ac_power_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:text="AC Power"
                    android:textOff="OFF"
                    android:textOn="ON" />

                <Switch
                    android:id="@+id/swing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Swing" />
            </LinearLayout>

            <!-- Temperature Controls -->
            <TextView
                android:id="@+id/tvCurrentTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Temperature:"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_decrease_temp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/arrow_down_float" />

                <TextView
                    android:id="@+id/temp_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="23°C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/button_increase_temp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/arrow_up_float" />
            </LinearLayout>

            <!-- Fan Control -->
            <TextView
                android:id="@+id/fan_level_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Fan Level: 1"
                android:textSize="16sp" />

            <Button
                android:id="@+id/fan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAN" />

</LinearLayout>