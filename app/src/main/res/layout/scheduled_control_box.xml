<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/scheduled_control_box.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="10dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_ac_controls_title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="Scheduled AC Controls"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- AC Power and Swing Switches -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/ac_power_switch1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:text="AC Power"
            android:textOff="OFF"
            android:textOn="ON" />

        <Switch
            android:id="@+id/swing1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swing" />
    </LinearLayout>

    <!-- Temperature Controls -->
    <TextView
        android:id="@+id/tvCurrentTemp1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Temperature:"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_decrease_temp1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="centerInside"
            android:src="@android:drawable/arrow_down_float" />

        <TextView
            android:id="@+id/temp_display1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="23°C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/button_increase_temp1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackground"
            android:scaleType="centerInside"
            android:src="@android:drawable/arrow_up_float" />
    </LinearLayout>

    <!-- Fan Control -->
    <TextView
        android:id="@+id/fan_level_display1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Fan Level: 1"
        android:textSize="16sp" />

    <Button
        android:id="@+id/fan1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FAN" />
</LinearLayout>
