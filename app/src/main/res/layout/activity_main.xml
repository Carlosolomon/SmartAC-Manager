<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:ignore="ExtraText">



    <!-- Top Fixed Section -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Test Mode Indicator -->
        <TextView
            android:id="@+id/testModeIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/holo_red_light"
            android:text="Test Mode Activated"
            android:textColor="@android:color/white"
            android:padding="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Imam Side AC Input -->
        <EditText
            android:id="@+id/editText_ac_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Number of ACs? Imam side"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:textAlignment="center"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:id="@+id/up_ac_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" />

        <!-- Left and Right Containers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Left Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/editText_ac_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Enter ACs (Left)"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:textAlignment="center"
                    android:layout_gravity="center_horizontal" />

                <LinearLayout
                    android:id="@+id/left_ac_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center" />
            </LinearLayout>

            <ImageView
                android:id="@+id/mihrab_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/mihrab_image"
                android:contentDescription="Mihrab"
                android:scaleType="fitCenter"
                android:layout_gravity="center"
                android:layout_margin="16dp" />

            <!-- Right Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/editText_ac_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Enter ACs (Right)"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:textAlignment="center"
                    android:layout_gravity="center_horizontal" />

                <LinearLayout
                    android:id="@+id/right_ac_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Down Section Container -->
        <EditText
            android:id="@+id/editText_ac_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Enter ACs (Down)"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:textAlignment="center"
            android:layout_gravity="center_horizontal" />

        <Button
            android:id="@+id/button_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="All" />

        <LinearLayout
            android:id="@+id/down_ac_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" />
    </LinearLayout>



    <!-- Divider -->
    <View
        android:id="@+id/top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable Section -->
    <ScrollView
        android:id="@+id/scrollable_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <LinearLayout
                android:fitsSystemWindows="true"

                android:id="@+id/bottom_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    >

                <!-- ✅ Tab Buttons (Top of Box) -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/ac_mode_toggle_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    app:singleSelection="true"
                    app:checkedButton="@+id/btn_realtime_tab"
                    android:background="@drawable/tab_group_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_realtime_tab"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Real-time"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/purple_500" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scheduled_tab"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Scheduled"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:backgroundTint="@android:color/white" />
                </com.google.android.material.button.MaterialButtonToggleGroup>


                <androidx.cardview.widget.CardView
                    android:id="@+id/ac_controls_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-12dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"

                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:cardPreventCornerOverlap="false"
                    app:layout_constraintTop_toBottomOf="@id/top_divider"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- ✅ Tabs moved OUTSIDE the padded block to appear like browser tabs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">



                        <!-- ✅ Inner layout with padding for content -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center_horizontal">

                            <!-- ✅ Tab Content -->
                            <FrameLayout
                                android:id="@+id/control_tab_content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <!-- ✅ ViewStubs with proper layout_width/height -->
                                <ViewStub
                                    android:id="@+id/realtime_controls"
                                    android:inflatedId="@+id/inflated_realtime_controls"
                                    android:layout="@layout/realtime_control_box"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                                <ViewStub
                                    android:id="@+id/scheduled_controls"
                                    android:inflatedId="@+id/inflated_scheduled_controls"
                                    android:layout="@layout/scheduled_control_box"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone" />
                            </FrameLayout>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                </LinearLayout>



                <!-- comment start
<Button
                 android:id="@+id/button_setup"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginTop="8dp"
                 android:layout_gravity="center_horizontal"
                 android:text="Setup" />    -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_test_esp_assignment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AC ID Assignment" />

                    <Space
                        android:layout_width="16dp"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/btnClearTerminal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear Terminal" />
                </LinearLayout>




                <ScrollView
                 android:id="@+id/terminalScroll"
                 android:layout_width="match_parent"
                 android:layout_height="180dp"
                    android:layout_marginBottom="60dp">

                 <TextView
                     android:id="@+id/terminal_output"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:padding="8dp"
                     android:text="Terminal: " />
             </ScrollView>

             <LinearLayout
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content">



                 <!--
                    <Button
                        android:id="@+id/btnSwitchUi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="Switch Page" />    -->

                    <!-- New Button to Display Prayer Times -->
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/bottom_framelayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemIconSize="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />


    <include
        layout="@layout/status_indicators"
        android:id="@+id/globalConnectionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        />

</androidx.constraintlayout.widget.ConstraintLayout>


